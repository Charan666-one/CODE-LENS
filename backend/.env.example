# CodeLens — local environment template. Copy to `.env` (which is gitignored).
#
# Every value below has a working default in app/core/config.py; this file
# exists to document the surface, not because anything is required to boot.

# ── Storage (CP-1.4) ──────────────────────────────────────────────────────
SQLITE_PATH=data/codelens.db

# ── Ingestion limits (CP-1.1) ─────────────────────────────────────────────
CLONE_DIR=/tmp/codelens
MAX_REPO_SIZE_MB=500
CLONE_TIMEOUT_SECONDS=300

# ── Semantic layer (Stage 3 — CP-3.2) ─────────────────────────────────────
# Leave unset until Stage 3. Stages 0-2 must run with zero LLM calls.
# Pick ONE. "auto" (the default) uses whichever is set, free options first.
# Groq — free tier, fast, recommended to start:
# GROQ_API_KEY=
# OpenRouter — free models available:
# OPENROUTER_API_KEY=
# Ollama — fully local, no key, unlimited: install ollama then set
# LLM_PROVIDER=ollama
# Anthropic — paid:
# ANTHROPIC_API_KEY=
# Optional: override the provider's default model
# LLM_MODEL=
