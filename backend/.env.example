# CodeLens — local environment template. Copy to `.env` (which is gitignored).
#
# Every value below has a working default in app/core/config.py; this file
# exists to document the surface, not because anything is required to boot.

# ── Storage (CP-1.4) ──────────────────────────────────────────────────────
SQLITE_PATH=data/codelens.db

# ── Ingestion limits (CP-1.1) ─────────────────────────────────────────────
CLONE_DIR=/tmp/codelens
MAX_REPO_SIZE_MB=500
CLONE_TIMEOUT_SECONDS=300

# ── Semantic layer (Stage 3 — CP-3.2) ─────────────────────────────────────
# Leave unset until Stage 3. Stages 0-2 must run with zero LLM calls.
# Pick ONE. "auto" (the default) uses whichever is set, free options first.
# Groq — free tier, fast, recommended to start:
# GROQ_API_KEY=
# OpenRouter — free models available:
# OPENROUTER_API_KEY=
# Ollama — fully local, no key, unlimited. Install ollama, pull a model, then
# uncomment BOTH of the next two lines (leaving LLM_PROVIDER set to a provider
# you have no key for is the one way to get a confusing failure):
# LLM_PROVIDER=ollama
# Anthropic — paid:
# ANTHROPIC_API_KEY=
# Optional — pin a provider explicitly instead of letting "auto" choose.
# Leave this UNSET unless you mean it: it overrides key detection entirely.
# LLM_PROVIDER=groq
# Optional: override the provider's default model
# LLM_MODEL=

# ── Serving ───────────────────────────────────────────────────────────────
# Browser origins allowed to call this API, comma-separated. Under docker
# compose the browser never calls it directly (Next proxies /api server-side),
# so this only matters if you publish the backend.
CORS_ORIGINS=http://localhost:3000

# ── Public-instance limits ────────────────────────────────────────────────
# This API clones whatever repository it is handed. See DEPLOYING.md and
# app/core/limits.py for what each ceiling defends against. Defaults suit a
# small public demo; raise them for a private instance.
RATE_LIMIT_ANALYSES=5
RATE_LIMIT_WINDOW_SECONDS=300
MAX_CONCURRENT_ANALYSES=2
MAX_CLONE_CACHE_MB=4000
MAX_FINISHED_JOBS=200
